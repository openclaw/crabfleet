{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crabbox-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "node scripts/generate-assets.mjs",
    "watch_dir": [
      "scripts/generate-assets.mjs",
      "vite.config.mjs",
      "src/app.html",
      "src/index.ts",
      "src/terminal-protocol.ts",
      "src/app",
      "src/assets",
      "docs/spec.md",
      "docs/spec-v2.md",
    ],
  },
  "account_id": "91b59577e757131d68d55a471fe32aca",
  "vars": {
    "BACKUP_BUCKET_NAME": "crabfleet-session-logs",
    "CLOUDFLARE_ACCOUNT_ID": "91b59577e757131d68d55a471fe32aca",
    "CRABFLEET_DEV_LOGIN_ENABLED": "false",
    "CRABBOX_INTERACTIVE_PROVISION_URL": "https://crabfleet.openclaw.ai/api/provision/interactive",
    "GITHUB_REDIRECT_URI": "https://crabfleet.openclaw.ai/auth/github/callback",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crabbox-ai",
      "database_id": "0866ed65-a568-4d9f-a78a-aec41fe75e06",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SESSION_LOGS",
      "bucket_name": "crabfleet-session-logs",
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "crabfleet-session-logs",
    },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 20,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "Sandbox",
      },
      {
        "name": "SESSION_CONTROL",
        "class_name": "SessionControlDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "sandbox-v1",
      "new_sqlite_classes": ["Sandbox"],
    },
    {
      "tag": "session-control-v1",
      "new_sqlite_classes": ["SessionControlDO"],
    },
  ],
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"],
  },
  // The canonical app/API host and legacy OpenClaw aliases are Worker Custom
  // Domains. The public crabfleet.ai product site uses wrangler.product.jsonc.
  "routes": [
    { "pattern": "crabfleet.openclaw.ai", "custom_domain": true },
    { "pattern": "clawfleet.openclaw.ai", "custom_domain": true },
    { "pattern": "crabyard.openclaw.ai", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
  },
}
