{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Preserve the deployed Worker and database identities for existing desktop clients.
  "name": "crabbox-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "node scripts/generate-assets.mjs",
    "watch_dir": [
      "scripts/generate-assets.mjs",
      "vite.config.mjs",
      "src/app.html",
      "src/app",
      "src/assets",
    ],
  },
  "account_id": "91b59577e757131d68d55a471fe32aca",
  "vars": {
    "CRABFLEET_DEV_LOGIN_ENABLED": "false",
    "GITHUB_REDIRECT_URI": "https://crabfleet.openclaw.ai/auth/github/callback",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crabbox-ai",
      "database_id": "0866ed65-a568-4d9f-a78a-aec41fe75e06",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "DESKTOP_RELAY", "class_name": "DesktopRelayDO" }],
  },
  "migrations": [
    { "tag": "sandbox-v1", "new_sqlite_classes": ["Sandbox"] },
    { "tag": "session-control-v1", "new_sqlite_classes": ["SessionControlDO"] },
    { "tag": "desktop-relay-v1", "new_sqlite_classes": ["DesktopRelayDO"] },
    { "tag": "desktop-only-v1", "deleted_classes": ["Sandbox", "SessionControlDO"] },
  ],
  "workers_dev": false,
  "triggers": { "crons": ["0 * * * *"] },
  // Existing app and product Custom Domains are maintained by ensure-cloudflare-domains.mjs.
  "observability": { "enabled": true },
}
